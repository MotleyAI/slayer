{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@motley-ai/slayer": [
        "./src/index.ts"
      ],
      "@motley-ai/slayer/node": [
        "./src/node.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples"
  ]
}
