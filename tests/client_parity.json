      "ts": {"args": [{"entityType": "datasource", "compact": false, "format": "json", "numRows": 0, "showSql": true, "sections": ["columns"], "descriptionsMaxChars": 80}]},
      "expect": {"method": "POST", "path": "/inspect", "query": {}, "body": {"reference": null, "entity_type": "datasource", "compact": false, "format": "json", "num_rows": 0, "show_sql": true, "sections": ["columns"], "descriptions_max_chars": 80}}
