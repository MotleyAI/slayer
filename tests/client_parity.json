  "python_only": [
    "query_sync", "sql_sync", "explain_sync", "inspect_sync", "recommend_root_model_sync",
    "list_models_sync", "get_model_sync", "query_df"
  ],
  "ts_only": [],
  "responses": {
    "query": {"data": [{"n": 1}], "row_count": 1, "columns": ["n"], "sql": "SELECT 1", "attributes": {"dimensions": {}, "measures": {}}, "population": null, "population_inferred": false, "warnings": []},
    "sql": {"data": [], "row_count": 0, "columns": [], "sql": "SELECT 1", "attributes": {"dimensions": {}, "measures": {}}, "population": null, "population_inferred": false, "warnings": []},
    "explain": {"data": [{"plan": "SCAN"}], "row_count": 1, "columns": ["plan"], "sql": "SELECT 1", "attributes": {"dimensions": {}, "measures": {}}, "population": null, "population_inferred": false, "warnings": []},
    "list_models": [{"name": "orders", "data_source": "ds", "description": "Orders"}],
    "get_model": {"name": "orders", "sql_table": "orders_t", "data_source": "ds", "columns": []},
