    "create_datasource": {"status": "created", "name": "ds2"},
    "get_datasource_priority": {"priority": ["ds"]},
    "set_datasource_priority": {"status": "ok", "priority": ["ds", "ds2"]},
    "save_memory": {"memory_id": "mem1", "resolved_entities": ["ds.orders.status"], "warnings": []},
    "forget_memory": {"deleted_id": "team.mem-1"},
    "search": {"results": [], "resolved_input_entities": [], "warnings": []},
    "inspect": {"result": "# orders"},
    "recommend_root_model": {"data_source": "ds", "root_model": "orders", "reachable": true, "item_paths": [{"input_item": "orders.amount", "path": "amount", "attachment": false, "unrelated": false}], "coverage": [], "message": "ok", "warnings": []},
    "health": {"status": "ok"}
  },
  "cases": [
    {
      "name": "single query: runtime variables override, dry_run sent",
      "op": "query",
      "python": {"args": [{"source_model": "orders", "measures": ["revenue"], "variables": {"a": 1, "b": 2}}], "kwargs": {"variables": {"b": 3}, "dry_run": true}},
      "ts": {"args": [{"source_model": "orders", "measures": ["revenue"], "variables": {"a": 1, "b": 2}}, {"variables": {"b": 3}, "dryRun": true}]},
      "expect": {"method": "POST", "path": "/query", "query": {}, "body": {"source_model": "orders", "measures": ["revenue"], "variables": {"a": 1, "b": 3}, "dry_run": true}}
    },
    {
      "name": "single query: flags omitted when not set",
      "op": "query",
      "python": {"args": [{"source_model": "orders", "measures": ["revenue"], "dimensions": ["status"]}], "kwargs": {}},
      "ts": {"args": [{"source_model": "orders", "measures": ["revenue"], "dimensions": ["status"]}]},
      "expect": {"method": "POST", "path": "/query", "query": {}, "body": {"source_model": "orders", "measures": ["revenue"], "dimensions": ["status"]}}
    },
    {
      "name": "saved query by name with refine",
      "op": "query",
      "python": {"args": ["monthly_revenue"], "kwargs": {"refine": {"limit": 5}}},
      "ts": {"args": ["monthly_revenue", {"refine": {"limit": 5}}]},
      "expect": {"method": "POST", "path": "/query", "query": {}, "body": {"name": "monthly_revenue", "refine": {"limit": 5}}}
    },
    {
      "name": "stage list",
      "op": "query",
      "python": {"args": [[{"name": "s1", "source_model": "orders", "measures": ["revenue"]}, {"source_model": "s1", "measures": ["revenue:sum"]}]], "kwargs": {}},
      "ts": {"args": [[{"name": "s1", "source_model": "orders", "measures": ["revenue"]}, {"source_model": "s1", "measures": ["revenue:sum"]}]]},
      "expect": {"method": "POST", "path": "/query", "query": {}, "body": {"queries": [{"name": "s1", "source_model": "orders", "measures": ["revenue"]}, {"source_model": "s1", "measures": ["revenue:sum"]}]}}
    },
    {
      "name": "stage list with top-level variables and explain",
      "op": "query",
      "python": {"args": [[{"source_model": "orders", "measures": ["revenue"]}]], "kwargs": {"variables": {"x": 1}, "explain": true}},
      "ts": {"args": [[{"source_model": "orders", "measures": ["revenue"]}], {"variables": {"x": 1}, "explain": true}]},
      "expect": {"method": "POST", "path": "/query", "query": {}, "body": {"queries": [{"source_model": "orders", "measures": ["revenue"]}], "variables": {"x": 1}, "explain": true}}
    },
    {
      "name": "sql is a dry run",
      "op": "sql",
      "python": {"args": [{"source_model": "orders", "measures": ["revenue"]}], "kwargs": {}},
      "ts": {"args": [{"source_model": "orders", "measures": ["revenue"]}]},
      "expect": {"method": "POST", "path": "/query", "query": {}, "body": {"source_model": "orders", "measures": ["revenue"], "dry_run": true}},
      "returns": "SELECT 1"
    },
    {
      "name": "explain sets explain",
      "op": "explain",
      "python": {"args": ["monthly_revenue"], "kwargs": {}},
      "ts": {"args": ["monthly_revenue"]},
      "expect": {"method": "POST", "path": "/query", "query": {}, "body": {"name": "monthly_revenue", "explain": true}}
    },
