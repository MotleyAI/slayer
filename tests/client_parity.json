    {
      "name": "search with every option",
      "op": "search",
      "python": {"args": [], "kwargs": {"entities": ["orders"], "query": {"source_model": "orders", "measures": ["revenue"]}, "question": "q", "datasource": "ds", "max_results": 5, "cypher_filter": "n.kind = 'model'", "compact": false}},
      "ts": {"args": [{"entities": ["orders"], "query": {"source_model": "orders", "measures": ["revenue"]}, "question": "q", "datasource": "ds", "maxResults": 5, "cypherFilter": "n.kind = 'model'", "compact": false}]},
      "expect": {"method": "POST", "path": "/search", "query": {}, "body": {"entities": ["orders"], "query": {"source_model": "orders", "measures": ["revenue"]}, "question": "q", "datasource": "ds", "max_results": 5, "cypher_filter": "n.kind = 'model'", "compact": false}}
    },
    {
