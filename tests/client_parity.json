    {
      "name": "health without a token sends no Authorization",
      "op": "health",
      "python": {"args": [], "kwargs": {}},
      "ts": {"args": []},
      "expect": {"method": "GET", "path": "/health", "query": {}, "body": null, "absent_headers": ["authorization"]}
    },
    {
      "name": "static token and extra headers",
      "op": "health",
      "client": {"token": "t1", "headers": {"X-Tenant": "acme"}},
      "python": {"args": [], "kwargs": {}},
      "ts": {"args": []},
      "expect": {"method": "GET", "path": "/health", "query": {}, "body": null, "headers": {"authorization": "Bearer t1", "x-tenant": "acme"}}
    },
    {
      "name": "with_token copy keeps headers and swaps the token",
      "op": "health",
      "client": {"token": "t1", "headers": {"X-Tenant": "acme"}},
      "with_token": "user-jwt",
      "python": {"args": [], "kwargs": {}},
      "ts": {"args": []},
      "expect": {"method": "GET", "path": "/health", "query": {}, "body": null, "headers": {"authorization": "Bearer user-jwt", "x-tenant": "acme"}}
    }
