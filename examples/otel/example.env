# Settings for every service in docker-compose.yml. Only for this local example.
#
# OpenTelemetry settings for the SLayer service. Apart from SLAYER_OTEL and SLAYER_OTEL_CAPTURE,
# these are standard OTEL_* variables: to send to another backend, change the endpoint and the
# headers. Nothing else is OpenObserve- or vendor-specific.
SLAYER_OTEL=on
OTEL_SERVICE_NAME=slayer
OTEL_METRIC_EXPORT_INTERVAL=10000

# Traces, metrics and logs all export over OTLP by default (the OTel standard default).
# Set OTEL_TRACES_EXPORTER, OTEL_METRICS_EXPORTER or OTEL_LOGS_EXPORTER to none to switch one off.
# Logs leave as message templates (no arguments, exception class only). Their level follows
# Python logging; OTEL_PYTHON_LOG_LEVEL sets it for SLayer's loggers.
OTEL_PYTHON_LOG_LEVEL=info

# Sensitive data is off by default. To debug with full detail on your own backend, opt in:
#   sql         adds db.query.text (the executed SQL) to database spans
#   exceptions  adds exception messages and stack traces to spans, and full messages to logs
# Both can contain row-level-security values and filter literals.
# SLAYER_OTEL_CAPTURE=sql,exceptions

# OpenObserve (the default backend in docker-compose.yml). The header is Basic auth for the
# local test user below, base64("root@example.com:Complexpass#123"), with the space as %20.
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20cm9vdEBleGFtcGxlLmNvbTpDb21wbGV4cGFzcyMxMjM=

# Local test user for the OpenObserve container. Only for this example.
ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD=Complexpass#123

# Local test password for the Postgres container. prepare.py and the seed service read it too.
POSTGRES_PASSWORD=slayer

# Test traffic sends no usage reports.
SLAYER_USAGE_REPORTING=off
