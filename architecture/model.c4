// ONE LikeC4 model of SLayer's structure. Model truth: relations are the
// AST-measured runtime import edges at every declared granularity — modules
// attribute to their finest declared child, coverage licenses each edge by its
// most-specific arrow (la-arch-check). Authoring convention: see
// system.arc42.md §5.

specification {
  element system
  element node
  element bucket {
    #virtual
  }
  tag virtual
  tag legacy
}
model {
  python = system 'SLayer' {
    core = node 'Core domain models' {
      metadata {
        package 'slayer.core'
        claims ['slayer.async_utils']
      }
      query = node 'Query'
      models = node 'Models'
      syntax = node 'Syntax'
    }
    sql = node 'SQL generation' {
      metadata {
        package 'slayer.sql'
        specs ['sql']
      }
      render = node 'Render'
      dialects = node 'Dialects'
      sql_predicate = node 'SQL predicate'
      window_detect = node 'Window detect'
    }
    engine = node 'Query engine' {
      metadata {
        package 'slayer.engine'
      }
      binding = node 'Binding'
      bind_inputs = node 'Bind inputs'
      elaborate_env = node 'Checker'
      elaborate = node 'Elaborate'
      compile = node 'Compile'
      plan = node 'Plan'
      population = node 'Population'
      cardinality = node 'Cardinality'
    }
    database = node 'Database access' {
      metadata {
        package 'slayer.database'
        specs ['database']
      }
    }
    live_schema = node 'Live schema' {
      metadata {
        package 'slayer.live_schema'
      }
    }
    ir = node 'Intermediate representation' {
      metadata {
        package 'slayer.ir'
      }
    }
    storage = node 'Storage backends' {
      metadata {
        package 'slayer.storage'
        specs ['storage']
      }
      migrations = node 'Migrations'
    }
    importers = bucket 'Importers' {
      metadata {
        packages ['slayer.dbt', 'slayer.cube', 'slayer.osi', 'slayer.ingest_report', 'slayer.importers']
        specs ['importers']
      }
    }
    search = bucket 'Search & embeddings' {
      metadata {
        packages ['slayer.search', 'slayer.embeddings']
      }
    }
    memories = bucket 'Agent memories' {
      metadata {
        packages ['slayer.memories']
      }
    }
    protocols = bucket 'BI wire protocols' {
      metadata {
        packages ['slayer.flight', 'slayer.pg_facade', 'slayer.facade']
        specs ['facade']
      }
    }
    usage_reporting = node 'Usage reporting' {
      metadata {
        package 'slayer.usage_reporting'
        specs ['usage-reporting']
      }
      features = node 'Features'
    }
    surfaces = bucket 'User-facing surfaces' {
      metadata {
        packages ['slayer.api', 'slayer.mcp', 'slayer.cli', 'slayer.client', 'slayer.inspect', 'slayer.demo', 'slayer.__main__']
        specs ['mcp', 'demo']
      }
    }

    core.models -> sql.dialects #legacy
    core.models -> sql.sql_predicate #legacy
    core.models -> sql.window_detect #legacy
    core.query -> sql.window_detect #legacy
    core.models -> storage.migrations #legacy
    core.query -> storage.migrations #legacy
    core.models -> core.query #legacy
    core.query -> core.models
    core.query -> core.syntax
    sql.render -> sql.dialects
    sql.sql_predicate -> sql.window_detect
    engine.binding -> core.syntax
    engine.bind_inputs -> engine.binding
    engine.bind_inputs -> engine.elaborate_env
    engine.bind_inputs -> core.syntax
    engine.compile -> engine.elaborate
    engine.compile -> engine.elaborate_env
    engine.elaborate -> engine.bind_inputs
    engine.elaborate -> engine.elaborate_env
    engine.plan -> engine.compile
    engine.plan -> engine.elaborate
    engine.binding -> engine.population
    engine.bind_inputs -> engine.population
    engine.bind_inputs -> engine.cardinality
    engine.elaborate -> engine.population
    engine.elaborate -> engine.cardinality
    engine.compile -> engine.population
    engine.compile -> engine.cardinality
    engine.plan -> engine.cardinality
    engine.population -> engine.cardinality
    engine.cardinality -> engine.elaborate_env
    database -> core
    database -> sql
    engine -> core
    engine -> database
    engine -> live_schema
    engine -> ir
    engine -> memories
    engine -> sql
    engine -> storage
    importers -> core
    importers -> database
    importers -> live_schema
    importers -> engine
    importers -> sql
    ir -> core
    live_schema -> core
    live_schema -> database
    live_schema -> engine
    live_schema -> memories
    live_schema -> search
    live_schema -> sql
    live_schema -> storage
    memories -> core
    memories -> engine
    memories -> search
    memories -> storage
    protocols -> core
    protocols -> engine
    protocols -> storage
    search -> core
    search -> engine
    search -> memories
    search -> storage
    sql -> core
    sql -> ir
    storage -> core
    storage -> database
    storage -> engine
    storage -> live_schema
    storage -> memories
    storage -> search
    storage -> sql
    surfaces -> core
    surfaces -> database
    surfaces -> engine
    surfaces -> importers
    surfaces -> live_schema
    surfaces -> memories
    surfaces -> protocols
    surfaces -> search
    surfaces -> storage
    protocols -> usage_reporting
    surfaces -> usage_reporting
    usage_reporting.features -> core
    usage_reporting.features -> sql
  }
}
